* ============================================================
* tanpura_models.lib  -  SPICE models for the Tanpura amplifier
* Keep this file in the SAME folder as tanpura_amp.kicad_sch
*
* NOTE: the transistor models below are GENERIC, approximate models
* (typical Gummel-Poon values). They are good for checking the circuit
* behaviour, but they are not manufacturer-certified models.
* ============================================================

* ---- uA741 / LM741 macromodel (Boyle et al. 1974) -------------------
* Pin order: 1=IN+  2=IN-  3=V+  4=V-  5=OUT
* (POLY sources rewritten as equivalent B-sources so no XSPICE is needed)
.SUBCKT UA741 1 2 3 4 5
C1 11 12 8.661E-12
C2 6 7 30.00E-12
DC 5 53 DX
DE 54 5 DX
DLP 90 91 DX
DLN 92 90 DX
DP 4 3 DX
BGND 99 0 V=0.5*V(3)+0.5*V(4)
BFB 7 99 I=10.61E6*I(VB)-10E6*I(VC)+10E6*I(VE)+10E6*I(VLP)-10E6*I(VLN)
GA 6 0 11 12 188.5E-6
GCM 0 6 10 99 5.961E-9
IEE 10 4 DC 15.16E-6
HLIM 90 0 VLIM 1K
Q1 11 2 13 QX
Q2 12 1 14 QX
R2 6 9 100.0E3
RC1 3 11 5.305E3
RC2 3 12 5.305E3
RE1 13 10 1.836E3
RE2 14 10 1.836E3
REE 10 99 13.19E6
RO1 8 5 50
RO2 7 99 100
RP 3 4 18.16E3
VB 9 0 DC 0
VC 3 53 DC 2.600
VE 54 4 DC 2.600
VLIM 7 8 DC 0
VLP 91 0 DC 25
VLN 0 92 DC 25
.MODEL DX D(IS=800.0E-18 RS=1)
.MODEL QX NPN(IS=800.0E-18 BF=93.75)
.ENDS UA741

* ---- Small-signal NPN / PNP (driver + bias transistors) -------------
.MODEL BC547 NPN(IS=1.8E-14 NF=0.9955 BF=400 VAF=80 IKF=0.14 ISE=5E-14 NE=1.46
+ BR=3.5 RB=0.56 RE=0.6 RC=0.25 CJE=13E-12 CJC=4E-12 TF=0.64E-9 TR=50E-9)
.MODEL BC337 NPN(IS=1.8E-14 NF=1 BF=250 VAF=100 IKF=0.6 ISE=1E-14 NE=1.5
+ BR=10 RB=1 RE=0.15 RC=0.1 CJE=30E-12 CJC=12E-12 TF=0.5E-9 TR=30E-9)
.MODEL BC327 PNP(IS=3E-14 NF=1 BF=250 VAF=60 IKF=0.6 ISE=1E-14 NE=1.5
+ BR=10 RB=1 RE=0.15 RC=0.1 CJE=40E-12 CJC=18E-12 TF=0.6E-9 TR=40E-9)

* ---- Power transistors: TIP31C (NPN) / TIP32C (PNP), TO-220 --------
* Pinout (KiCad symbols and datasheet):  pin1=B  pin2=C  pin3=E
.MODEL TIP31C NPN(IS=1E-13 NF=1 BF=90 VAF=100 IKF=2.5 ISE=2E-13 NE=1.5
+ BR=5 RB=0.4 RE=0.04 RC=0.06 CJE=250E-12 CJC=120E-12 TF=25E-9 TR=300E-9)
.MODEL TIP32C PNP(IS=1.3E-13 NF=1 BF=80 VAF=80 IKF=2.2 ISE=2.6E-13 NE=1.5
+ BR=5 RB=0.5 RE=0.04 RC=0.06 CJE=300E-12 CJC=150E-12 TF=30E-9 TR=350E-9)

* ---- Signal diode (amplitude limiter in the oscillators) ----------
.MODEL D1N4148 D(IS=2.52E-9 N=1.752)
